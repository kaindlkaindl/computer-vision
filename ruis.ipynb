   "source": [
    "import cv2\n",
    "\n",
    "IMAGE_PATH = \"fruitschaal.jpg\"\n",
    "OUTPUT_PATH = \"schoon_fruit.jpg\"\n",
    "\n",
    "img = cv2.imread(IMAGE_PATH)\n",
    "if img is None:\n",
    "    raise FileNotFoundError(f\"Kon afbeelding niet lezen: {IMAGE_PATH}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
